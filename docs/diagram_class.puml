@startuml diagram_class
title Diagramme de classes - MONSITE & IDPERSO & IdP externes

'Style
left to right direction
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam class {
  BackgroundColor White
  BorderColor Black
  ArrowColor Black
}
' Modifier la distance entre les classes
skinparam nodesep 4
' Modifier la distance verticale entre les paquets
skinparam ranksep 10
' Modifier la distance horizontale entre les paquets
skinparam packageMargin 4

'Objets

'Paquetage MONSITE
package "MONSITE - Client OAuth" as MONSITE #F5F8FF{

  interface OAuthProviderConfig <<type>> {
    +id, endpoints, scope, usePkce
    +mapUserInfo(raw): OAuthUserInfo
  }

  class OAuthUserInfo <<type>> {
    +provider, providerAccountId
    +email, name, avatarUrl
  }

  class SecurityUtils <<module>> {
    .. crypto/signedToken.ts, oauth/pkce.ts, oauth/state.ts ..
    +signToken() / verifyToken()
    +createPkcePair()
    +createOAuthState() / verifyOAuthState()
  }

  class AuthFlowController <<boundary>> {
    .. routes /api/auth/*, pages /login, /profile ..
    demarre et termine le flux OAuth
    (authorize, callback, logout)
  }

  class OAuthClient <<module>> {
    .. oauth/client.ts ..
    +buildAuthorizationUrl()
    +exchangeCodeForToken()
    +fetchUserInfo()
  }

  class SessionManager <<module>> {
    .. session.ts ..
    +createSessionToken()
    +readSession()
  }

  class ProviderRegistry <<module>> {
    .. providers/{google,github,idperso} ..
    +getProvider(id)
    +listProviders()
  }
}

'Paquetage IDPERSO
package "IDPERSO — Fournisseur d'identité (IdP)" as IDPERSO #FFF8F0 {

  class AuthorizeValidator <<module>> {
    .. oauth/validateAuthorizeRequest.ts ..
    +validateAuthorizeRequest(query)
  }

  class AuthCodeStore <<module>> {
    .. store/authCodes.ts ..
    +createAuthCode()
    +consumeAuthCode()
  }
  class AuthCodeRecord <<type>> {
    +clientId, redirectUri, userId
    +codeChallenge, expiresAt, consumed
  }

  class AccessTokenStore <<module>> {
    .. store/accessTokens.ts ..
    +createAccessToken()
    +getAccessToken()
  }
  class AccessTokenRecord <<type>> {
    +userId, clientId, scope, expiresAt
  }

  class UserStore <<module>> {
    .. users/store.ts (data/users.json) ..
    +createUser() / findUserByUsername()
    +verifyPassword()
  }
  class User <<type>> {
    +id, username, email
    +passwordHash, salt
  }

  class SessionManagerIdp <<module>> {
    .. session.ts ..
    +createSessionToken()
    +readSession()
  }

  class IdpEndpoints <<boundary>> {
    .. routes /oauth/{authorize,token,userinfo,login,logout}, /register ..
    expose le protocole OAuth v2 + PKCE
    (equivalent fonctionnel de Google)
  }
}

'Paquetage IdP externes
package "IdP externes" as IDPEXT #F0FFF8 {

  class GoogleIdP <<external>> {
    .. accounts.google.com / oauth2.googleapis.com / openidconnect.googleapis.com ..
    Authorization Server + Resource Server
    OIDC: code, token, userinfo
  }

  class GitHubIdP <<external>> {
    .. github.com / api.github.com ..
    Authorization Server + Resource Server
    OAuth 2.0: code, token, userinfo
  }
}

'Relations

'Relations MONSITE
AuthFlowController --> ProviderRegistry : sélectionne le provider
AuthFlowController --> OAuthClient : orchestre le flux OAuth
AuthFlowController --> SecurityUtils : utilise les utilitaires
AuthFlowController --> SessionManager : crée la session
ProviderRegistry --> OAuthProviderConfig : retourne la config
OAuthClient ..> OAuthProviderConfig : lit la config
OAuthClient ..> OAuthUserInfo : mappe le profil
SessionManager --> SecurityUtils : signe et vérifie
SessionManager ..> OAuthUserInfo : encapsule le profil

'Relations IDPERSO
IdpEndpoints --> AuthorizeValidator : valide l'autorisation
IdpEndpoints --> AuthCodeStore : émet les codes
IdpEndpoints --> AccessTokenStore : émet les jetons
IdpEndpoints --> UserStore : lit les utilisateurs
IdpEndpoints --> SessionManagerIdp : gère la session
AuthCodeStore --> AuthCodeRecord : stocke les codes
AccessTokenStore --> AccessTokenRecord : stocke les jetons
UserStore --> User : persiste les comptes

'Relations inter-systèmes
OAuthClient ..> GoogleIdP : HTTP - OAuth 2.0 + OIDC
OAuthClient ..> GitHubIdP : HTTP - OAuth 2.0
AuthFlowController ..> IdpEndpoints : HTTP - OAuth 2.0 + PKCE\n(authorize / token / userinfo)

'Disposition
IDPEXT -down[hidden]-> MONSITE
MONSITE -down[hidden]-> IDPERSO

@enduml
